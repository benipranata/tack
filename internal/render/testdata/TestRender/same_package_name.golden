)

func NewService(ctx context.Context) (Service, func(), error) {
	var cleanups []func()
	cleanup := func() {
		for i := len(cleanups) - 1; i >= 0; i-- {
			cleanups[i]()
		}
	}

	a, aCleanup, err := store.Provide(ctx)
	if err != nil {
		cleanup()
		return nil, nil, fmt.Errorf("store.Provide: %w", err)
	}
	if aCleanup != nil {
		cleanups = append(cleanups, aCleanup)
	}

	b, bCleanup, err := store2.Provide(ctx)
	if err != nil {
		cleanup()
		return nil, nil, fmt.Errorf("store2.Provide: %w", err)
	}
	if bCleanup != nil {
		cleanups = append(cleanups, bCleanup)
	}

	return &service{
		a: a,
		b: b,
	}, cleanup, nil
}

type service struct {
	a *store.Store
	b *store2.Store
}

func (s *service) A() *store.Store  { return s.a }
func (s *service) B() *store2.Store { return s.b }
