func NewService(ctx context.Context) (Service, func(), error) {
	var cleanups []func()
	cleanup := func() {
		for i := len(cleanups) - 1; i >= 0; i-- {
			cleanups[i]()
		}
	}

	primary, primaryCleanup, err := providers.ProvideDB(ctx)
	if err != nil {
		cleanup()
		return nil, nil, fmt.Errorf("ProvideDB: %w", err)
	}
	if primaryCleanup != nil {
		cleanups = append(cleanups, primaryCleanup)
	}

	return &service{
		primary: primary,
		replica: primary,
	}, cleanup, nil
}

type service struct {
	primary *sql.DB
	replica *sql.DB
}

func (s *service) Primary() *sql.DB { return s.primary }
func (s *service) Replica() *sql.DB { return s.replica }
