func newRedis(ctx context.Context) (redis, func(), error) {
	var cleanups []func()
	cleanup := func() {
		for i := len(cleanups) - 1; i >= 0; i-- {
			cleanups[i]()
		}
	}

	logger, loggerCleanup, err := providers.ProvideLogger(ctx)
	if err != nil {
		cleanup()
